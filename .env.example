# Copy to .env. Never commit .env.

# stdio for Cursor; streamable-http on Render
MCP_TRANSPORT=stdio

MCP_HOST=0.0.0.0
# Render injects PORT; local HTTP can use MCP_PORT
MCP_PORT=8008

# Required on Render (auto-generated in render.yaml); optional locally for HTTP tests
MCP_API_KEY=

DATA_DIR=./data
