# Copy to .env and fill in values. Never commit .env.

# Optional until you use GitHub tools (fine-grained PAT, read-only repo access)
GITHUB_TOKEN=

# stdio for Cursor locally; streamable-http for future Render deploy
MCP_TRANSPORT=stdio

MCP_HOST=0.0.0.0
MCP_PORT=8008

# Future HTTP deploy on Render (unused for stdio)
MCP_API_KEY=

# SQLite, notes, and career DB live here
DATA_DIR=./data
